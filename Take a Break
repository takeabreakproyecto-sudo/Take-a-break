        // Screen time calculator listener
        const hoursSlider = document.getElementById('hoursSlider');
        if (hoursSlider) {
            hoursSlider.addEventListener('input', (e) => {
                const hrs = parseFloat(e.target.value);
                const hoursVal = document.getElementById('hoursVal');
                if (hoursVal) hoursVal.textContent = hrs + (hrs === 1 ? ' hora' : ' horas');

                const yearHrs = Math.round(hrs * 365);
                const days = (yearHrs / 24).toFixed(1);
                const awakePercent = Math.round((hrs / 16) * 100);

                const books = Math.round(yearHrs / 30);
                const languages = (yearHrs / 600).toFixed(1);

                const calcYearHours = document.getElementById('calcYearHours');
                const calcDays = document.getElementById('calcDays');
                const calcAwakePercent = document.getElementById('calcAwakePercent');
                const calcBooks = document.getElementById('calcBooks');
                const calcLanguages = document.getElementById('calcLanguages');

                if (calcYearHours) calcYearHours.textContent = yearHrs.toLocaleString() + ' hrs';
                if (calcDays) calcDays.textContent = days + ' días completos';
                if (calcAwakePercent) calcAwakePercent.textContent = awakePercent + '%';
                if (calcBooks) calcBooks.textContent = books + ' Libros';
                if (calcLanguages) calcLanguages.textContent = languages + ' Idiomas';
            });
        }

        let quizScore = 0;
        function answerQuiz(step, points) {
            quizScore += points;
            const current = document.querySelector(`.quiz-step[data-step="${step}"]`);
            if (current) current.classList.add('hidden');

            const next = document.querySelector(`.quiz-step[data-step="${step + 1}"]`);
            if (next) {
                next.classList.remove('hidden');
            } else {
                showQuizResult();
            }
        }

        function showQuizResult() {
            const resultBox = document.getElementById('quiz-result');
            const icon = document.getElementById('quiz-icon');
            const title = document.getElementById('quiz-title');
            const desc = document.getElementById('quiz-desc');

            if (!resultBox) return;
            resultBox.classList.remove('hidden');

            if (quizScore <= 4) {
                if (icon) icon.innerHTML = '🌟';
                if (title) title.textContent = '¡Excelente Equilibrio Digital!';
                if (desc) desc.textContent = 'Demuestras una gran capacidad de autorregulación. Utilizas la tecnología como herramienta sin descuidar tu descanso y vida social.';
            } else if (quizScore <= 7) {
                if (icon) icon.innerHTML = '⚖️';
                if (title) title.textContent = 'Uso Moderado (Atención)';
                if (desc) desc.textContent = 'A veces el teléfono absorbe más tiempo del planeado. Implementar reglas sencillas como apagar notificaciones de noche te dará gran libertad.';
            } else {
                if (icon) icon.innerHTML = '⚠️';
                if (title) title.textContent = 'Riesgo de Hiperconexión';
                if (desc) desc.textContent = 'El teléfono está ocupando un espacio importante en tus rutinas cotidianas. ¡Es un momento ideal para unirte al compromiso Take a Break!';
            }
        }

        function resetQuiz() {
            quizScore = 0;
            const res = document.getElementById('quiz-result');
            if (res) res.classList.add('hidden');
            document.querySelectorAll('.quiz-step').forEach((el, index) => {
                if (index === 0) el.classList.remove('hidden');
                else el.classList.add('hidden');
            });
        }

