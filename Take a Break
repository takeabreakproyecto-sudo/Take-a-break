        let currentTriviaIdx = 0;
        let triviaScore = 0;
        let triviaAnswered = false;

        function loadTriviaQuestion() {
            triviaAnswered = false;
            const qData = triviaQuestions[currentTriviaIdx];
            
            const curQEl = document.getElementById('trivia-current-q');
            const totQEl = document.getElementById('trivia-total-q');
            const qEl = document.getElementById('trivia-question');
            const progEl = document.getElementById('trivia-progress');

            if (curQEl) curQEl.textContent = currentTriviaIdx + 1;
            if (totQEl) totQEl.textContent = triviaQuestions.length;
            if (qEl) qEl.textContent = qData.q;
            
            if (progEl) {
                const pct = ((currentTriviaIdx + 1) / triviaQuestions.length) * 100;
                progEl.style.width = pct + '%';
            }

            const fb = document.getElementById('trivia-feedback');
            const nxt = document.getElementById('trivia-next-btn');
            if (fb) fb.classList.add('hidden');
            if (nxt) nxt.classList.add('hidden');

            const optsContainer = document.getElementById('trivia-options');
            if (optsContainer) {
                optsContainer.innerHTML = '';
                qData.options.forEach((optText, i) => {
                    const btn = document.createElement('button');
                    btn.className = 'w-full p-4 rounded-xl bg-slate-700/80 hover:bg-slate-700 text-left text-xs sm:text-sm font-semibold text-slate-100 border border-slate-600 transition duration-200 flex items-center justify-between group cursor-pointer';
                    btn.innerHTML = `<span>${optText}</span> <i class="fa-regular fa-circle text-slate-400 group-hover:text-amber-400"></i>`;
                    btn.onclick = () => selectTriviaOption(i, btn);
                    optsContainer.appendChild(btn);
                });
            }
        }

        function selectTriviaOption(selectedIdx, btnElement) {
            if (triviaAnswered) return;
            triviaAnswered = true;

            const qData = triviaQuestions[currentTriviaIdx];
            const allBtns = document.querySelectorAll('#trivia-options button');
            const feedbackBox = document.getElementById('trivia-feedback');
            const feedbackTitle = document.getElementById('trivia-feedback-title');
            const feedbackText = document.getElementById('trivia-feedback-text');
            const nextBtn = document.getElementById('trivia-next-btn');

            allBtns.forEach(b => b.classList.add('opacity-60', 'cursor-not-allowed'));
            btnElement.classList.remove('opacity-60');

            if (selectedIdx === qData.correct) {
                triviaScore += 20;
                const scEl = document.getElementById('trivia-score');
                if (scEl) scEl.textContent = triviaScore;
                
                btnElement.classList.add('bg-emerald-600/30', 'border-emerald-500', 'text-emerald-200');
                btnElement.innerHTML += `<i class="fa-solid fa-circle-check text-emerald-400 text-lg"></i>`;

                if (feedbackBox) {
                    feedbackBox.className = 'p-4 rounded-2xl mb-6 text-xs sm:text-sm leading-relaxed border bg-emerald-950/60 border-emerald-700 text-emerald-200';
                    if (feedbackTitle) feedbackTitle.textContent = '¡Respuesta Correcta! (+20 pts)';
                }
            } else {
                btnElement.classList.add('bg-rose-600/30', 'border-rose-500', 'text-rose-200');
                btnElement.innerHTML += `<i class="fa-solid fa-circle-xmark text-rose-400 text-lg"></i>`;

                if (allBtns[qData.correct]) {
                    allBtns[qData.correct].classList.remove('opacity-60');
                    allBtns[qData.correct].classList.add('bg-emerald-600/20', 'border-emerald-500');
                }

                if (feedbackBox) {
                    feedbackBox.className = 'p-4 rounded-2xl mb-6 text-xs sm:text-sm leading-relaxed border bg-rose-950/60 border-rose-700 text-rose-200';
                    if (feedbackTitle) feedbackTitle.textContent = 'Respuesta Incorrecta';
                }
            }

            if (feedbackText) feedbackText.textContent = qData.explanation;
            if (feedbackBox) feedbackBox.classList.remove('hidden');
            if (nextBtn) nextBtn.classList.remove('hidden');
        }

        function nextTriviaQuestion() {
            currentTriviaIdx++;
            if (currentTriviaIdx < triviaQuestions.length) {
                loadTriviaQuestion();
            } else {
                showTriviaResults();
            }
        }

        function showTriviaResults() {
            const box = document.getElementById('trivia-box');
            const res = document.getElementById('trivia-result');
            const scoreEl = document.getElementById('trivia-final-score');
            const titleEl = document.getElementById('trivia-result-title');
            const descEl = document.getElementById('trivia-result-desc');

            if (box) box.classList.add('hidden');
            if (res) res.classList.remove('hidden');
            if (scoreEl) scoreEl.textContent = triviaScore;

            if (triviaScore >= 100) {
                if (titleEl) titleEl.textContent = '🏆 ¡Embajador del Bienestar Digital!';
                if (descEl) descEl.textContent = '¡Excelente trabajo! Conoces perfectamente los hábitos para un descanso óptimo y un uso inteligente del teléfono.';
