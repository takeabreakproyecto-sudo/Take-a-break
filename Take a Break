        const canvas = document.getElementById('gameCanvas');
        const ctx = canvas ? canvas.getContext('2d') : null;
        const overlay = document.getElementById('game-overlay');
        const startBtn = document.getElementById('start-game-btn');
        const gameScoreDisplay = document.getElementById('game-score');

        let gameRunning = false;
        let canvasScore = 0;
        let items = [];
        let spawnTimer = 0;

        const player = {
            x: 0,
            y: 0,
            width: 70,
            height: 18,
            speed: 7,
            dx: 0
        };

        function resizeCanvas() {
            if (!canvas) return;
            canvas.width = canvas.parentElement.clientWidth;
            canvas.height = canvas.parentElement.clientHeight;
            player.y = canvas.height - 35;
            if (player.x === 0) player.x = canvas.width / 2 - player.width / 2;
        }

        if (canvas) {
            window.addEventListener('resize', resizeCanvas);
            resizeCanvas();
        }

        const itemTypes = [
            { label: '📚', type: 'good' },
            { label: '⚽', type: 'good' },
            { label: '🌙', type: 'good' },
            { label: '🌿', type: 'good' },
            { label: '🔔', type: 'bad' },
            { label: '📱', type: 'bad' }
        ];

        function spawnItem() {
            if (!canvas) return;
            const item = itemTypes[Math.floor(Math.random() * itemTypes.length)];
            items.push({
                x: Math.random() * (canvas.width - 30) + 15,
                y: -20,
                speed: 2 + Math.random() * 2.5,
                label: item.label,
                type: item.type
            });
        }

        function updateGame() {
            if (!gameRunning || !canvas) return;

            player.x += player.dx;
            if (player.x < 0) player.x = 0;
            if (player.x + player.width > canvas.width) player.x = canvas.width - player.width;

            spawnTimer++;
            if (spawnTimer % 45 === 0) {
                spawnItem();
            }

            for (let i = items.length - 1; i >= 0; i--) {
                let it = items[i];
                it.y += it.speed;

                if (
                    it.y + 15 >= player.y &&
                    it.y - 15 <= player.y + player.height &&
                    it.x >= player.x &&
                    it.x <= player.x + player.width
                ) {
                    if (it.type === 'good') {
                        canvasScore += 10;
                    } else {
                        canvasScore = Math.max(0, canvasScore - 15);
                    }
                    if (gameScoreDisplay) gameScoreDisplay.textContent = canvasScore;
                    items.splice(i, 1);
                    continue;
                }

                if (it.y > canvas.height + 20) {
                    items.splice(i, 1);
                }
            }
        }

        function drawGame() {
            if (!ctx || !canvas) return;

            ctx.fillStyle = '#0f172a';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            ctx.fillStyle = '#14b8a6';
            ctx.beginPath();
            if (ctx.roundRect) {
                ctx.roundRect(player.x, player.y, player.width, player.height, 10);
            } else {
                ctx.rect(player.x, player.y, player.width, player.height);
            }
            ctx.fill();

            ctx.fillStyle = '#ffffff';
            ctx.font = '10px sans-serif';
            ctx.fillText('BALANCE', player.x + 10, player.y + 12);

            ctx.font = '22px sans-serif';
            ctx.textAlign = 'center';
            items.forEach(it => {
                ctx.fillText(it.label, it.x, it.y);
            });
        }

        function gameLoop() {
            updateGame();
            drawGame();
            if (gameRunning) {
                requestAnimationFrame(gameLoop);
            }
        }

        function startGame() {
            canvasScore = 0;
            if (gameScoreDisplay) gameScoreDisplay.textContent = '0';
            items = [];
            gameRunning = true;
            if (overlay) overlay.classList.add('hidden');
            gameLoop();
        }

        if (startBtn) {
            startBtn.addEventListener('click', startGame);
        }

        window.addEventListener('keydown', (e) => {
            if (e.key === 'ArrowLeft') player.dx = -player.speed;
            if (e.key === 'ArrowRight') player.dx = player.speed;
        });

        window.addEventListener('keyup', (e) => {
            if (e.key === 'ArrowLeft' || e.key === 'ArrowRight') player.dx = 0;
        });

        if (canvas) {
            canvas.addEventListener('touchmove', (e) => {
                if (!gameRunning) return;
                const touchX = e.touches[0].clientX;
                const rect = canvas.getBoundingClientRect();
                const relativeX = touchX - rect.left;
                player.x = relativeX - player.width / 2;
            }, { passive: true });
        }

        window.addEventListener('DOMContentLoaded', () => {
            loadTriviaQuestion();
        });
    </script>
